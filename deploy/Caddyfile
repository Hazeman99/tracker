{
	# No admin endpoint; restart the container to apply config changes.
	admin off
	http_port 80
	https_port {$TRACKER_HTTPS_PORT:443}
}

{$TRACKER_DOMAIN} {
	# TRACKER_TLS is an e-mail address (automatic Let's Encrypt
	# certificates) or the word "internal" (a self-signed certificate from
	# Caddy's local CA). Certificates are stored in the caddy-data volume.
	tls {$TRACKER_TLS:internal} {
		protocols tls1.2 tls1.3
	}

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		-Server
		-Via
	}

	# The API enforces its own, tighter per-route caps.
	request_body {
		max_size 2MB
	}

	reverse_proxy api:8080 {
		header_up -X-Forwarded-Host
	}
}

# Plain HTTP only redirects to HTTPS on the configured port (Caddy's
# automatic redirect would drop a non-standard port). The ACME HTTP
# challenge is answered before this site block is consulted.
http://{$TRACKER_DOMAIN} {
	redir https://{host}:{$TRACKER_HTTPS_PORT:443}{uri} permanent
}
