{
	# No admin endpoint; restart the container to apply config or certificate changes.
	admin off
	http_port 80
	https_port {$TRACKER_HTTPS_PORT:8443}
}

{$TRACKER_DOMAIN} {
	# Certificate for the Tailscale MagicDNS name, obtained on the host with
	# `tailscale cert` (deploy/renew-cert.sh). No ACME from inside Caddy.
	tls /certs/cert.pem /certs/key.pem {
		protocols tls1.2 tls1.3
	}

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		-Server
		-Via
	}

	# The API enforces its own, tighter per-route caps.
	request_body {
		max_size 2MB
	}

	reverse_proxy api:8080 {
		header_up -X-Forwarded-Host
	}
}

# Plain HTTP only redirects to HTTPS on the configured port. (Caddy's
# automatic redirect would drop the non-standard port.)
http://{$TRACKER_DOMAIN} {
	redir https://{host}:{$TRACKER_HTTPS_PORT:8443}{uri} permanent
}
