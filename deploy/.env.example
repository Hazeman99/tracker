# Copy to deploy/.env and edit. Nothing in this file is secret.

# The DNS name the server is reached at. The TLS certificate is issued for
# this name.
TRACKER_DOMAIN=tracker.example.com

# TLS mode. An e-mail address enables automatic Let's Encrypt certificates
# (the domain must resolve to this server and ports 80/443 must be reachable
# from the internet). The word "internal" makes Caddy issue a self-signed
# certificate instead (for LAN-only servers): then either trust Caddy's root
# CA on your devices or enable "Disable SSL certificate verification" when
# connecting the desktop app.
TRACKER_TLS=you@example.com

# Optional: the address ports are published on. Defaults to 0.0.0.0 (all
# interfaces); set a specific address (e.g. a VPN interface) to narrow it.
#TRACKER_BIND_IP=0.0.0.0

# Optional: the HTTPS port.
#TRACKER_HTTPS_PORT=443
