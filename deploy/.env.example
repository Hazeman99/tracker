# Copy to deploy/.env and edit. Nothing in this file is secret.

# The server's Tailscale MagicDNS name (see `tailscale status --self` or the
# Tailscale admin console). The TLS certificate is issued for this name.
TRACKER_DOMAIN=myserver.tailnet-name.ts.net

# The server's Tailscale IPv4 address (`tailscale ip -4`). Ports are published
# on this address only, so the API is reachable only from your tailnet.
TRACKER_BIND_IP=100.64.0.1

# HTTPS port. 443 is often taken by `tailscale serve`; 8443 avoids that.
TRACKER_HTTPS_PORT=8443
