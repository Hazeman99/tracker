# Lets WebKitGTK's own sandbox (bubblewrap) create unprivileged user
# namespaces on kernels that restrict them behind AppArmor (Ubuntu 23.10+,
# kernel.apparmor_restrict_unprivileged_userns=1). Without this the app
# aborts at launch with "bwrap: setting up uid map: Permission denied".
#
# Like Ubuntu's own browser profiles, it adds no confinement: it only gives
# the binary a profile name and grants userns.

abi <abi/4.0>,
include <tunables/global>

profile tracker /usr/local/bin/tracker flags=(unconfined) {
  userns,

  # Site-specific additions and overrides. See local/README for details.
  include if exists <local/tracker>
}
